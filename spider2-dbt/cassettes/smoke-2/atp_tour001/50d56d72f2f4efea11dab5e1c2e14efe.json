  "operation": "generate",
  "text": "\n{\"tool\": \"write_file\", \"input\": {\"path\": \"models/mart/rpt_match_summary.sql\", \"content\": \"{{ config(\\n    tags=[\\\"mart\\\", \\\"report\\\"]\\n  )\\n}}\\n\\nwith fct as (\\n    select *\\n      from {{ ref('fct_match') }}\\n)\\n, dim_date as (\\n    select *\\n      from {{ ref('dim_date') }}\\n)\\n, dim_tournament as (\\n    select *\\n      from {{ ref('dim_tournament') }}\\n)\\n, dim_player as (\\n    select *\\n      from {{ ref('dim_player') }}\\n)\\n, report as (\\n    select d.date_day as \\\"Date\\\"\\n          ,t.tournament_name as \\\"Tournament\\\"\\n          ,t.surface as \\\"Surface\\\"\\n          ,f.round as \\\"Round\\\"\\n          ,pw.player_name as \\\"Winner\\\"\\n          ,pl.player_name as \\\"Loser\\\"\\n          ,f.score as \\\"Score\\\"\\n          ,f.num_of_matches as \\\"Matches\\\"\\n          ,f.winner_num_of_aces as \\\"Aces\\\"\\n          ,date_part('year', d.date_day) as \\\"Year\\\"\\n          ,pw.dominant_hand as \\\"Hand\\\"\\n      from fct f\\n      left join dim_date d on cast(d.dim_date_key as varchar) = f.dim_tournament_date_key\\n      left join dim_tournament t on t.dim_tournament_key = f.dim_tournament_key\\n      left join dim_player pw on pw.dim_player_key = f.dim_player_winner_key\\n      left join dim_player pl on pl.dim_player_key = f.dim_player_loser_key\\n)\\nselect *\\n  from report\\n\"}}",
