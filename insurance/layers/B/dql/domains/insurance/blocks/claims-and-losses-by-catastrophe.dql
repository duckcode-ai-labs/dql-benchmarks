block "Claims and Losses by Catastrophe" {
    type = "semantic"
    status = "certified"
    domain = "insurance"
    description = "Catastrophe report: number of claims (claims that carry claim amounts), incurred losses and incurred loss and expense by catastrophe. Claim severity is incurred losses divided by claims. Catastrophe names in this data are perils, not named events; catastrophes without claims do not appear."
    tags = ["insurance", "claims", "catastrophe", "standard-report", "ai-authored", "app-source"]
    owner = "insurance-analytics@acme-insurance.test"
    metrics = ["claims_with_amounts", "incurred_losses", "incurred_loss_and_expense"]
    dimensions = ["claim__catastrophe__catastrophe_name"]
    order_by = ["incurred_losses desc"]

    visualization {
        chart = "table"
    }
}
