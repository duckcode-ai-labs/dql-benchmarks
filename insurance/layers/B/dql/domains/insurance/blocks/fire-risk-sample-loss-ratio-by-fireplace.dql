block "Fire Risk Sample Loss Ratio by Fireplace" {
    type = "semantic"
    status = "certified"
    domain = "insurance"
    description = "Fire-risk sample report: number of records and unweighted average loss ratio by whether the property has a fireplace. fire_claim is a separate sample that cannot be linked to the policies, claims or premium of the policy book. This loss ratio is not the loss ratio of the policy book."
    tags = ["insurance", "fire-risk", "loss-ratio", "standard-report", "ai-authored", "app-source"]
    owner = "insurance-analytics@acme-insurance.test"
    metrics = ["fire_risk_records", "fire_sample_avg_loss_ratio"]
    dimensions = ["fire_risk_record__fireplace"]
    order_by = ["fire_risk_record__fireplace asc"]

    visualization {
        chart = "table"
    }
}
