// dql-format: 1

domain "Insurance" {
  id = "insurance"
  owner = "insurance-analytics@acme-insurance.test"
  businessOwner = "ACME Insurance Property and Casualty Analytics"
  boundedContext = "Property and casualty insurance for ACME: policies and their coverage periods, premiums and other policy amounts, the parties on a policy (policy holder, agent) and on an underwriting assessment (underwriter), claims against coverage with their loss and expense reserves and payments, catastrophes and loss occurrences, insured objects and their addresses. Modeled on the OMG Property and Casualty data model."
  reviewCadence = "quarterly"
  sourceSystems = ["dbt:policy", "dbt:agreement", "dbt:agreement_party_role", "dbt:party", "dbt:person", "dbt:organizations", "dbt:party_role", "dbt:policy_coverage_detail", "dbt:policy_amount", "dbt:premium", "dbt:claim", "dbt:claim_amount", "dbt:loss_payment", "dbt:loss_reserve", "dbt:expense_payment", "dbt:expense_reserve", "dbt:claim_coverage", "dbt:catastrophe", "dbt:occurrences", "dbt:insurable_object", "dbt:geographic_location", "dbt:location_address", "dbt:pysical_location", "dbt:assessment", "dbt:assessment_result", "dbt:underwriting_assessment", "dbt:agreement_assessment", "dbt:assesment_party_role", "dbt:fire_claim"]
  primaryTerms = ["Policy", "Policy Holder", "Agent", "Underwriter", "Premium", "Policy Coverage Detail", "Claim", "Loss Payment", "Loss Reserve", "Expense Payment", "Expense Reserve", "Catastrophe", "Insurable Object", "Location"]
  tags = ["insurance", "property-and-casualty", "omg-pc-model"]
  dbtPaths = ["models/omg_models"]
  description = "One domain for the whole ACME P&C warehouse. Entities bind the dbt models in models/omg_models (materialized as views in schema main). KPIs are governed as metrics in models/business_semantics (layer B) and the standard reports are draft blocks in blocks/."
}
