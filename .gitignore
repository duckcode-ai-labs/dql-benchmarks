# Downloaded benchmark data and working copies: large, rebuildable, and under
# their publishers' licenses.
data/
work/

# Python environment for dbt and the publishers' graders.
.venv/
.venv-mf/

# The DQL version installed from dql.json.
.dql-cli/

# Databases produced by runs. Reports and submission metadata are committed;
# the databases themselves are rebuilt from the recorded runs.
*.duckdb
*.duckdb.wal
submissions/**/*.duckdb

node_modules/
.DS_Store
*.log

# Database drivers DQL loads at runtime (scripts/install-connectors.mjs).
.connectors/

# Provider settings for benchmark runs (sign in here; never copied from another workspace).
.provider-workspace/

# Notes kept outside this repository.
private/
*.private.md

# Sealed question sets and their evidence: committed only on their release day
# (docs/RELEASE-CHECKLIST.md). Set 4 until the paper is posted; set 5 until its run is reported.
insurance/heldout/questions-4.json
insurance/heldout/questions-5.json
results/**/heldout-4*/
results/**/heldout-5*/
insurance/audit/*.csv
# Generated paper outputs (rebuilt by paper_docx.py; the posted PDF is committed by hand)
analysis/**/*.docx
analysis/**/gdoc.html
analysis/**/whitepaper.html
log.txt
