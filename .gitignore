# Downloaded benchmark data and working copies: large, rebuildable, and under
# their publishers' licenses.
data/
work/

# Python environment for dbt and the publishers' graders.
.venv/

# The DQL version installed from dql.json.
.dql-cli/

# Databases produced by runs. Reports and submission metadata are committed;
# the databases themselves are rebuilt from the recorded runs.
*.duckdb
*.duckdb.wal
submissions/**/*.duckdb

node_modules/
.DS_Store
*.log

# Database drivers DQL loads at runtime (scripts/install-connectors.mjs).
.connectors/
