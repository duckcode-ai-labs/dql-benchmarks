domain "NBA" {
    id = "nba"
    owner = "Kranthi"
    businessOwner = "Kranthi"
    description = "NBA games, teams and players for seasons 2003-04 through 2022-23 (2022 partial, games to 2022-12-22), from the nba_analysis dbt project on DuckDB."
    boundedContext = "Game results, team and player box scores, and season aggregates. Analysis-ready tables are the local_* facts in TRANSFORMED (deduplicated, all 20 seasons, DNP rows flagged), plus dim_teams_cleansed and dim_seasons. The int_*, fct_player_*, dim_players_cleansed, src_* and stg_* models are build layers with partial seasons, duplicates or DNP games counted as played."
    businessOutcome = "Correct player, team and game statistics across every season the data holds."
    sourceSystems = ["nba_analysis dbt project", "Kaggle NBA games CSVs (games.csv, games_details.csv, players.csv, ranking.csv, teams.csv)"]
    inScope = ["games and results", "team game lines and team seasons", "player game lines and player seasons", "daily standings", "team reference data"]
    outOfScope = ["player biographies beyond the 2016 sample", "play-by-play", "contracts and salaries"]
    reviewCadence = "monthly"
    tags = ["nba", "basketball", "sports"]
}
