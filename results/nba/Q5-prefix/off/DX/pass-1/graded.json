    "entities": true,
    "failure_reason": "wrong_result",
    "sql": "WITH tg AS (\n  SELECT game_date_est, games_game_id, home_team_id AS team_id, home_team_wins AS win\n  FROM enterprise_dw.TRANSFORMED.src_games\n  WHERE season = 2012 AND games_game_id // 10000000 = 2 AND home_team_wins IS NOT NULL\n  UNION ALL\n  SELECT game_date_est, games_game_id, visitor_team_id AS team_id, 1 - home_team_wins AS win\n  FROM enterprise_dw.TRANSFORMED.src_games\n  WHERE season = 2012 AND games_game_id // 10000000 = 2 AND home_team_wins IS NOT NULL\n),\nnumbered AS (\n  SELECT team_id, win, game_date_est, games_game_id,\n         ROW_NUMBER() OVER (PARTITION BY team_id ORDER BY game_date_est, games_game_id)\n         - ROW_NUMBER() OVER (PARTITION BY team_id, win ORDER BY game_date_est, games_game_id) AS grp\n  FROM tg\n),\nstreaks AS (\n  SELECT team_id, grp, COUNT(*) AS streak_length,\n         MIN(game_date_est) AS streak_start, MAX(game_date_est) AS streak_end\n  FROM numbered\n  WHERE win = 1\n  GROUP BY team_id, grp\n),\nranked AS (\n  SELECT *, RANK() OVER (ORDER BY streak_length DESC) AS rnk\n  FROM streaks\n),\nnames AS (\n  SELECT TEAM_ID AS team_id, MAX(TEAM) AS team_name\n  FROM enterprise_dw.RAW.raw_ranking\n  GROUP BY TEAM_ID\n)\nSELECT r.team_id, n.team_name, r.streak_length, r.streak_start, r.streak_end\nFROM ranked r\nLEFT JOIN names n ON n.team_id = r.team_id\nWHERE r.rnk = 1\nORDER BY r.team_id",
