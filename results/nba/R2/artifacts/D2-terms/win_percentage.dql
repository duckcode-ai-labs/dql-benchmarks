// dql-format: 1

term "win percentage" {
  type = "metric"
  status = "draft"
  description = "Share of games played that a team won: wins divided by games played. Reads TRANSFORMED.local_team_season_facts.win_pct, TRANSFORMED.src_ranking.w_pct."
  tags = ["ai-draft"]
  synonyms = ["win pct", "winning percentage", "W%"]
}
