// dql-format: 1

term "position" {
  type = "dimension"
  status = "draft"
  description = "The position a player plays (e.g. G, F, C) from the bio record; starting position is separate in box scores. Reads TRANSFORMED.fct_player_performance.PLAYER_POSITION, TRANSFORMED.fct_player_journey.player_position, TRANSFORMED.src_games_details.player_start_position."
  tags = ["ai-draft"]
  synonyms = ["player position", "role", "starting position"]
}
