// dql-format: 1

term "height" {
  type = "dimension"
  status = "draft"
  description = "Player height; in centimetres in the journey and staging tables, converted from feet-inches. Reads TRANSFORMED.fct_player_journey.height_cm, TRANSFORMED.stg_player_information.HEIGHT_CM, TRANSFORMED.fct_player_performance.HEIGHT."
  tags = ["ai-draft"]
  synonyms = ["player height", "tall"]
}
