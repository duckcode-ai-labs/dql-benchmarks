// dql-format: 1

term "plus/minus" {
  type = "metric"
  status = "draft"
  description = "Net point difference for the team while the player was on court in a game. Reads TRANSFORMED.int_player_stats.plus_minus, TRANSFORMED.local_player_game_facts.plus_minus, TRANSFORMED.src_games_details.plus_minus."
  tags = ["ai-draft"]
  synonyms = ["+/-", "plus minus"]
}
