// dql-format: 1

term "did not play" {
  type = "concept"
  status = "draft"
  description = "A player-game row where the player did not take part, flagged by participated = false, with the reason in comment_text. Reads TRANSFORMED.local_player_game_facts.participated, TRANSFORMED.local_player_game_facts.comment_text."
  tags = ["ai-draft"]
  synonyms = ["DNP", "inactive", "non-participant"]
}
