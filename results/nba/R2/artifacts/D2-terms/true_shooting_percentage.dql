// dql-format: 1

term "true shooting percentage" {
  type = "metric"
  status = "draft"
  description = "Scoring efficiency that accounts for field goals, three-pointers and free throws, as stored for each player season. Reads TRANSFORMED.fct_player_performance.true_shooting_pct."
  tags = ["ai-draft"]
  synonyms = ["TS%", "TS"]
}
