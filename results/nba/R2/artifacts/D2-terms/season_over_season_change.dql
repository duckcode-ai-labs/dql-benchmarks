// dql-format: 1

term "season-over-season change" {
  type = "metric"
  status = "draft"
  description = "Current season value minus the prior season value for points, assists, rebounds or efficiency. Reads TRANSFORMED.fct_player_journey.pts_delta, TRANSFORMED.fct_player_journey.ast_delta, TRANSFORMED.fct_player_journey.reb_delta, TRANSFORMED.fct_player_journey.efficiency_delta."
  tags = ["ai-draft"]
  synonyms = ["year-over-year change", "delta", "improvement"]
}
