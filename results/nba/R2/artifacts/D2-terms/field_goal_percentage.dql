// dql-format: 1

term "field goal percentage" {
  type = "metric"
  status = "draft"
  description = "Share of field goal attempts made; per season it is made divided by attempted (or an average of game percentages in the fct/int tables). Reads TRANSFORMED.local_player_season_facts.field_goal_pct, TRANSFORMED.fct_player_performance.avg_field_goal_pct, TRANSFORMED.int_player_stats.fg_pct."
  tags = ["ai-draft"]
  synonyms = ["FG%", "shooting percentage"]
}
