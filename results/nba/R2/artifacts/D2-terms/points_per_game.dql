// dql-format: 1

term "points per game" {
  type = "metric"
  status = "draft"
  description = "Average points a player scores per game played, i.e. total points divided by games played. Reads TRANSFORMED.fct_player_performance.points_per_game, TRANSFORMED.local_player_season_facts.points_per_game."
  tags = ["ai-draft"]
  synonyms = ["PPG", "scoring average"]
}
