// dql-format: 1

term "free throw percentage" {
  type = "metric"
  status = "draft"
  description = "Share of free throw attempts made; season value is made divided by attempted, or an average of game percentages in the fct/int tables. Reads TRANSFORMED.local_player_season_facts.free_throw_pct, TRANSFORMED.fct_player_performance.avg_free_throw_pct, TRANSFORMED.int_player_stats.ft_pct."
  tags = ["ai-draft"]
  synonyms = ["FT%"]
}
