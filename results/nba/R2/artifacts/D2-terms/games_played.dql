// dql-format: 1

term "games played" {
  type = "metric"
  status = "draft"
  description = "Number of games a player appeared in during a season (participated rows only in local tables) or that a team played. Reads TRANSFORMED.local_player_season_facts.games_played, TRANSFORMED.fct_player_performance.games_played, TRANSFORMED.local_team_season_facts.games_played."
  tags = ["ai-draft"]
  synonyms = ["GP", "appearances"]
}
