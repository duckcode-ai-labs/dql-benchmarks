// dql-format: 1

term "career totals" {
  type = "metric"
  status = "draft"
  description = "Cumulative points, assists, rebounds and games played through and including a given season. Reads TRANSFORMED.fct_player_journey.career_pts, TRANSFORMED.fct_player_journey.career_ast, TRANSFORMED.fct_player_journey.career_reb, TRANSFORMED.fct_player_journey.career_games_played."
  tags = ["ai-draft"]
  synonyms = ["career points", "career stats", "lifetime totals"]
}
