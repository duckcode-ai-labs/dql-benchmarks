// dql-format: 1

term "standings" {
  type = "concept"
  status = "draft"
  description = "A team's record (games, wins, losses, win percentage) as of a given standings date, by conference. Reads TRANSFORMED.src_ranking.standings_date, TRANSFORMED.src_ranking.conference, TRANSFORMED.src_ranking.w, TRANSFORMED.src_ranking.l, RAW.raw_ranking.STANDINGSDATE."
  tags = ["ai-draft"]
  synonyms = ["league table", "ranking", "conference standing"]
}
