// dql-format: 1

term "road record" {
  type = "metric"
  status = "draft"
  description = "A team's wins and losses in away games; in season facts, away_wins out of away_games. Reads TRANSFORMED.local_team_season_facts.away_wins, TRANSFORMED.local_team_season_facts.away_games, TRANSFORMED.src_ranking.road_record."
  tags = ["ai-draft"]
  synonyms = ["away record", "away wins"]
}
