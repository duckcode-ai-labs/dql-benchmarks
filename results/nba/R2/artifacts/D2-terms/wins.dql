// dql-format: 1

term "wins" {
  type = "metric"
  status = "draft"
  description = "Number of games a team won in a season, counted from team_won in team-game rows. Reads TRANSFORMED.local_team_season_facts.wins, TRANSFORMED.local_team_game_facts.team_won."
  tags = ["ai-draft"]
  synonyms = ["W", "victories"]
}
