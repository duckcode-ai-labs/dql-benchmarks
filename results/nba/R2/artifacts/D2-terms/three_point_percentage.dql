// dql-format: 1

term "three-point percentage" {
  type = "metric"
  status = "draft"
  description = "Share of three-point attempts made; season value is made divided by attempted, or an average of game percentages in the fct/int tables. Reads TRANSFORMED.local_player_season_facts.three_point_pct, TRANSFORMED.fct_player_performance.avg_three_point_pct, TRANSFORMED.int_player_stats.fg3_pct."
  tags = ["ai-draft"]
  synonyms = ["3P%", "three point percentage", "3PT%"]
}
