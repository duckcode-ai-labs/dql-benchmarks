// dql-format: 1

term "effective field goal percentage" {
  type = "metric"
  status = "draft"
  description = "Field goal percentage that gives extra credit for three-pointers, as stored for each player season. Reads TRANSFORMED.fct_player_performance.effective_field_goal_pct."
  tags = ["ai-draft"]
  synonyms = ["eFG%", "eFG"]
}
