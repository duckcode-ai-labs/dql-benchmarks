// dql-format: 1

term "point differential" {
  type = "metric"
  status = "draft"
  description = "Points a team scored minus points allowed over the season. Reads TRANSFORMED.local_team_season_facts.point_differential, TRANSFORMED.local_team_season_facts.total_points, TRANSFORMED.local_team_season_facts.opponent_points."
  tags = ["ai-draft"]
  synonyms = ["point diff", "scoring margin"]
}
