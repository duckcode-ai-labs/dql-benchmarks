// dql-format: 1

term "home record" {
  type = "metric"
  status = "draft"
  description = "A team's wins and losses in home games; in season facts, home_wins out of home_games. Reads TRANSFORMED.local_team_season_facts.home_wins, TRANSFORMED.local_team_season_facts.home_games, TRANSFORMED.src_ranking.home_record."
  tags = ["ai-draft"]
  synonyms = ["home wins", "record at home"]
}
