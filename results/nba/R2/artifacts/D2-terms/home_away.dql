// dql-format: 1

term "home/away" {
  type = "dimension"
  status = "draft"
  description = "Whether a team or player's team was the home side in a game, from is_home. Reads TRANSFORMED.local_team_game_facts.is_home, TRANSFORMED.local_player_game_facts.is_home."
  tags = ["ai-draft"]
  synonyms = ["home game", "away game", "venue side"]
}
