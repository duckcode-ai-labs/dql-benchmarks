// dql-format: 1

term "losses" {
  type = "metric"
  status = "draft"
  description = "Number of games a team lost in a season, counted from team_lost in team-game rows. Reads TRANSFORMED.local_team_season_facts.losses, TRANSFORMED.local_team_game_facts.team_lost."
  tags = ["ai-draft"]
  synonyms = ["L", "defeats"]
}
