// dql-format: 1

term "field goal percentage" {
  type = "metric"
  status = "draft"
  description = "Average of per-game field goal percentage across games played in a season, from avg_field_goal_pct. It is an average of game percentages, not made divided by attempted. Reads TRANSFORMED.fct_player_journey.avg_field_goal_pct."
  tags = ["ai-draft"]
  synonyms = ["FG%", "shooting percentage"]
}
