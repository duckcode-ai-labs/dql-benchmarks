// dql-format: 1

term "season" {
  type = "dimension"
  status = "draft"
  description = "The NBA season (year) in which stats were recorded; seasons have names and start/end dates in dim_seasons. Reads TRANSFORMED.fct_player_journey.season, TRANSFORMED.dim_seasons.season_name, TRANSFORMED.dim_seasons.start_date, TRANSFORMED.dim_seasons.end_date."
  tags = ["ai-draft"]
  synonyms = ["year", "season year"]
}
