term "home game" {
  type = "concept"
  status = "draft"
  description = "A team-game where the team played at home, flagged by is_home; otherwise it is an away game. Reads TRANSFORMED.local_team_game_facts.is_home."
  tags = ["ai-draft"]
  synonyms = ["home", "away game", "road game"]
}
