// dql-format: 1

term "career season number" {
  type = "dimension"
  status = "draft"
  description = "Ordinal position of a season in a player's career, 1 for rookie season and increasing by 1 each season. Reads TRANSFORMED.fct_player_journey.career_season_number."
  tags = ["ai-draft"]
  synonyms = ["year in the league", "season of career"]
}
