// dql-format: 1

term "did not play" {
  type = "concept"
  status = "draft"
  description = "A player-game row where the player did not take part (DNP or comment rows), flagged by participated = false; participated rows are the ones counted in games played. Reads TRANSFORMED.local_player_game_facts.participated."
  tags = ["ai-draft"]
  synonyms = ["DNP", "inactive", "did not participate"]
}
