// dql-format: 1

term "games played" {
  type = "metric"
  status = "draft"
  description = "Number of distinct games a player played in a season (or a team played in a season in the local season tables). Player-season counts only include games where the player participated. Reads TRANSFORMED.fct_player_journey.games_played, TRANSFORMED.local_player_season_facts.games_played, TRANSFORMED.local_team_season_facts.games_played."
  tags = ["ai-draft"]
  synonyms = ["GP", "appearances"]
}
