// dql-format: 1

term "efficiency rating" {
  type = "metric"
  status = "draft"
  description = "Player efficiency (EFF) for a season: (points + rebounds + assists + steals + blocks - missed field goals - missed free throws - turnovers) divided by games played; NULL when games played is 0. Reads TRANSFORMED.fct_player_journey.efficiency_rating."
  tags = ["ai-draft"]
  synonyms = ["EFF", "PER", "player efficiency"]
}
