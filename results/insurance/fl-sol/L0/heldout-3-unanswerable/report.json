      "name": "heldout-unanswerable-what-deductible-applies-to-each-policy-and-how-o-3fdd38",
      "passed": false,
      "failures": [
        "expected a refusal (question is out of scope / unanswerable), but the run answered with kind uncertified"
      ],
      "durationMs": 109820,
      "kind": "uncertified",
      "route": "generated_sql",
      "clarificationOptionCount": 0,
      "conversational": false,
      "conversationalAnswer": false,
      "meaningResolved": false,
      "observability": {
        "recordingStatus": "complete",
        "storeSchemaVersion": 1,
        "traceFingerprint": "sha256:0f5d23a99cc44c16289342a49f6fa1863f17dc839cfd8a149242f25a9a056642"
      },
      "reviewStatus": "analyst_review_required",
      "followUp": false,
      "draftSaved": false,
      "toolCalls": 3,
      "providerDispatchCount": 5,
      "expected": {
        "answerable": false
      },
      "answer": {
        "trustState": "review_required",
        "tier": "exploratory",
        "proofs": [
          "executed on the warehouse: 2 rows in 5 ms"
        ],
        "sql": "WITH deductibles AS (\n    SELECT\n        Policy_Identifier,\n        Insurable_Object_Identifier,\n        Insurance_Type_Code,\n        Policy_Amount AS deductible,\n        ROW_NUMBER() OVER (\n            PARTITION BY Policy_Identifier, Insurable_Object_Identifier, Insurance_Type_Code\n            ORDER BY Effective_Date DESC NULLS LAST, Policy_Amount_Identifier DESC\n        ) AS rn\n    FROM \"acme_insurance\".\"main\".\"policy_amount\"\n    WHERE Amount_Type_Code ILIKE '%deductible%'\n),\nclaim_totals AS (\n    SELECT\n        c.Claim_Identifier,\n        c.Insurable_Object_Identifier,\n        ca.Insurance_Type_Code,\n        SUM(ca.Claim_Amount) AS claim_amount\n    FROM \"acme_insurance\".\"main\".\"claim\" AS c\n    JOIN \"acme_insurance\".\"main\".\"claim_amount\" AS ca\n        ON c.Claim_Identifier = ca.Claim_Identifier\n    GROUP BY c.Claim_Identifier, c.Insurable_Object_Identifier, ca.Insurance_Type_Code\n)\nSELECT\n    p.Policy_Identifier,\n    p.Policy_Number,\n    list_sort(list_distinct(list(d.deductible) FILTER (WHERE d.deductible IS NOT NULL))) AS applicable_deductibles,\n    COUNT(DISTINCT ct.Claim_Identifier) AS claims_with_amounts,\n    COUNT(DISTINCT ct.Claim_Identifier) FILTER (\n        WHERE ct.claim_amount < d.deductible\n    ) AS claims_below_deductible,\n    COUNT(DISTINCT ct.Claim_Identifier) FILTER (\n        WHERE ct.claim_amount < d.deductible\n    )::DOUBLE / NULLIF(COUNT(DISTINCT ct.Claim_Identifier), 0) AS share_below_deductible\nFROM \"acme_insurance\".\"main\".\"policy\" AS p\nLEFT JOIN deductibles AS d\n    ON p.Policy_Identifier = d.Policy_Identifier\n    AND d.rn = 1\nLEFT JOIN claim_totals AS ct\n    ON d.Insurable_Object_Identifier = ct.Insurable_Object_Identifier\n    AND d.Insurance_Type_Code = ct.Insurance_Type_Code\nGROUP BY p.Policy_Identifier, p.Policy_Number\nORDER BY p.Policy_Number, p.Policy_Identifier\nLIMIT 500",
        "rowCount": 2,
        "egress": {
          "receipts": 5,
          "resultRows": 0
        }
      },
