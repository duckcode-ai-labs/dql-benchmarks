      "answer": {
        "trustState": "review_required",
        "tier": "exploratory",
        "proofs": [
          "executed on the warehouse: 2 rows in 5 ms"
        ],
        "sql": "WITH deductibles AS (\n    SELECT\n        pa.Policy_Identifier,\n        MAX(pa.Policy_Amount) AS deductible\n    FROM \"acme_insurance\".\"main\".\"policy_amount\" AS pa\n    WHERE NOT EXISTS (\n        SELECT 1\n        FROM \"acme_insurance\".\"main\".\"premium\" AS pr\n        WHERE pr.Policy_Amount_Identifier = pa.Policy_Amount_Identifier\n    )\n    GROUP BY pa.Policy_Identifier\n),\nclaim_totals AS (\n    SELECT\n        Claim_Identifier,\n        SUM(Claim_Amount) AS claim_amount\n    FROM \"acme_insurance\".\"main\".\"claim_amount\"\n    GROUP BY Claim_Identifier\n),\npolicy_claims AS (\n    SELECT DISTINCT\n        pcd.Policy_Identifier,\n        c.Claim_Identifier,\n        c.Company_Claim_Number,\n        ct.claim_amount\n    FROM \"acme_insurance\".\"main\".\"claim\" AS c\n    JOIN \"acme_insurance\".\"main\".\"claim_coverage\" AS cc\n        ON c.Claim_Identifier = cc.Claim_Identifier\n    JOIN \"acme_insurance\".\"main\".\"policy_coverage_detail\" AS pcd\n        ON cc.Effective_Date = pcd.Effective_Date\n       AND cc.Policy_Coverage_Detail_Identifier = pcd.Policy_Coverage_Detail_Identifier\n    LEFT JOIN claim_totals AS ct\n        ON c.Claim_Identifier = ct.Claim_Identifier\n)\nSELECT\n    p.Policy_Identifier,\n    p.Policy_Number,\n    d.deductible,\n    COUNT(pc.Company_Claim_Number) AS claims,\n    COUNT(pc.Company_Claim_Number) FILTER (\n        WHERE pc.claim_amount < d.deductible\n    ) AS claims_below_deductible\nFROM \"acme_insurance\".\"main\".\"policy\" AS p\nLEFT JOIN deductibles AS d\n    ON p.Policy_Identifier = d.Policy_Identifier\nLEFT JOIN policy_claims AS pc\n    ON p.Policy_Identifier = pc.Policy_Identifier\nGROUP BY p.Policy_Identifier, p.Policy_Number, d.deductible\nORDER BY p.Policy_Identifier\nLIMIT 500",
        "rowCount": 2,
        "egress": {
          "receipts": 8,
          "resultRows": 0
        }
      },
