    {
      "name": "heldout-unanswerable-what-deductible-applies-to-each-policy-and-how-o-3fdd38",
      "passed": false,
      "failures": [
        "expected a refusal (question is out of scope / unanswerable), but the run answered with kind uncertified"
      ],
      "durationMs": 64155,
      "kind": "uncertified",
      "route": "generated_sql",
      "clarificationOptionCount": 0,
      "conversational": false,
      "conversationalAnswer": false,
      "meaningResolved": false,
      "observability": {
        "recordingStatus": "complete",
        "storeSchemaVersion": 1,
        "traceFingerprint": "sha256:6e5c552272f5c76e6e6df58875b0c285ddece72fb582addb2da18eb28f78d60b"
      },
      "reviewStatus": "analyst_review_required",
      "followUp": false,
      "draftSaved": false,
      "toolCalls": 2,
      "providerDispatchCount": 3,
      "expected": {
        "answerable": false
      },
      "answer": {
        "trustState": "review_required",
        "tier": "exploratory",
        "proofs": [
          "executed on the warehouse: 2 rows in 7 ms"
        ],
        "sql": "WITH policy_deductible AS (\n    SELECT\n        COALESCE(pa.Policy_Identifier, pcd.Policy_Identifier) AS Policy_Identifier,\n        MAX(pa.Policy_Amount) AS deductible\n    FROM acme_insurance.main.policy_amount AS pa\n    LEFT JOIN acme_insurance.main.policy_coverage_detail AS pcd\n        ON pa.Policy_Coverage_Detail_Identifier = pcd.Policy_Coverage_Detail_Identifier\n    WHERE pa.Amount_Type_Code ILIKE '%deduct%'\n       OR UPPER(TRIM(pa.Amount_Type_Code)) IN ('DED', 'DEDUCT', 'DEDUCTABLE', 'D')\n    GROUP BY COALESCE(pa.Policy_Identifier, pcd.Policy_Identifier)\n),\nclaim_total AS (\n    SELECT\n        Claim_Identifier,\n        SUM(Claim_Amount) AS claim_amount\n    FROM acme_insurance.main.claim_amount\n    GROUP BY Claim_Identifier\n),\nclaim_policy AS (\n    SELECT DISTINCT\n        cc.Claim_Identifier,\n        pcd.Policy_Identifier\n    FROM acme_insurance.main.claim_coverage AS cc\n    JOIN acme_insurance.main.policy_coverage_detail AS pcd\n        ON cc.Policy_Coverage_Detail_Identifier = pcd.Policy_Coverage_Detail_Identifier\n)\nSELECT\n    p.Policy_Identifier,\n    p.Policy_Number,\n    d.deductible,\n    COUNT(ct.Claim_Identifier) AS claims_with_amount,\n    COUNT(ct.Claim_Identifier) FILTER (\n        WHERE ct.claim_amount < d.deductible\n    ) AS claims_below_deductible,\n    COUNT(ct.Claim_Identifier) FILTER (\n        WHERE ct.claim_amount < d.deductible\n    ) * 1.0 / NULLIF(COUNT(ct.Claim_Identifier), 0) AS share_below_deductible\nFROM acme_insurance.main.policy AS p\nLEFT JOIN policy_deductible AS d\n    ON p.Policy_Identifier = d.Policy_Identifier\nLEFT JOIN claim_policy AS cp\n    ON p.Policy_Identifier = cp.Policy_Identifier\nLEFT JOIN claim_total AS ct\n    ON cp.Claim_Identifier = ct.Claim_Identifier\nGROUP BY\n    p.Policy_Identifier,\n    p.Policy_Number,\n    d.deductible\nORDER BY p.Policy_Identifier\nLIMIT 500",
        "rowCount": 2,
        "egress": {
          "receipts": 3,
          "resultRows": 0
        }
      },
