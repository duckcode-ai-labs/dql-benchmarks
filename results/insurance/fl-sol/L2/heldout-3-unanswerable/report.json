    {
      "name": "heldout-unanswerable-what-deductible-applies-to-each-policy-and-how-o-3fdd38",
      "passed": false,
      "failures": [
        "expected a refusal (question is out of scope / unanswerable), but the run answered with kind uncertified"
      ],
      "durationMs": 85448,
      "kind": "uncertified",
      "route": "generated_sql",
      "clarificationOptionCount": 0,
      "conversational": false,
      "conversationalAnswer": false,
      "meaningResolved": false,
      "observability": {
        "recordingStatus": "complete",
        "storeSchemaVersion": 1,
        "traceFingerprint": "sha256:d47ac77e2a9bd5fa789935649835cbbdb84e6a5977b5ec8f1fa9a29c142f3352"
      },
      "reviewStatus": "analyst_review_required",
      "followUp": false,
      "draftSaved": false,
      "toolCalls": 1,
      "providerDispatchCount": 6,
      "expected": {
        "answerable": false
      },
      "answer": {
        "trustState": "review_required",
        "tier": "exploratory",
        "proofs": [
          "executed on the warehouse: 2 rows in 5 ms"
        ],
        "sql": "WITH policy_deductibles AS (\n    SELECT\n        Policy_Identifier,\n        SUM(Policy_Amount) AS deductible\n    FROM \"acme_insurance\".\"main\".\"policy_amount\"\n    WHERE LOWER(Amount_Type_Code) LIKE '%deductible%'\n    GROUP BY Policy_Identifier\n),\nclaim_totals AS (\n    SELECT\n        Claim_Identifier,\n        SUM(Claim_Amount) AS claim_amount\n    FROM \"acme_insurance\".\"main\".\"claim_amount\"\n    GROUP BY Claim_Identifier\n),\npolicy_claims AS (\n    SELECT DISTINCT\n        pcd.Policy_Identifier,\n        cc.Claim_Identifier\n    FROM \"acme_insurance\".\"main\".\"claim_coverage\" AS cc\n    JOIN \"acme_insurance\".\"main\".\"policy_coverage_detail\" AS pcd\n        ON cc.Policy_Coverage_Detail_Identifier = pcd.Policy_Coverage_Detail_Identifier\n       AND cc.Effective_Date = pcd.Effective_Date\n)\nSELECT\n    p.Policy_Identifier,\n    p.Policy_Number,\n    pd.deductible,\n    COUNT(DISTINCT c.Company_Claim_Number) AS claims,\n    COUNT(DISTINCT CASE\n        WHEN ct.claim_amount < pd.deductible THEN c.Company_Claim_Number\n    END) AS claims_below_deductible,\n    COUNT(DISTINCT CASE\n        WHEN ct.claim_amount < pd.deductible THEN c.Company_Claim_Number\n    END) * 1.0\n        / NULLIF(COUNT(DISTINCT c.Company_Claim_Number), 0) AS share_below_deductible\nFROM \"acme_insurance\".\"main\".\"policy\" AS p\nLEFT JOIN policy_deductibles AS pd\n    ON p.Policy_Identifier = pd.Policy_Identifier\nLEFT JOIN policy_claims AS pc\n    ON p.Policy_Identifier = pc.Policy_Identifier\nLEFT JOIN \"acme_insurance\".\"main\".\"claim\" AS c\n    ON pc.Claim_Identifier = c.Claim_Identifier\nLEFT JOIN claim_totals AS ct\n    ON c.Claim_Identifier = ct.Claim_Identifier\nGROUP BY p.Policy_Identifier, p.Policy_Number, pd.deductible\nORDER BY p.Policy_Identifier\nLIMIT 500",
        "rowCount": 2,
        "egress": {
          "receipts": 6,
          "resultRows": 0
        }
      },
