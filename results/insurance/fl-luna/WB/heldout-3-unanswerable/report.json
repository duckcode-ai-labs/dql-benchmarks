      "name": "heldout-unanswerable-what-deductible-applies-to-each-policy-and-how-o-3fdd38",
      "passed": false,
      "failures": [
        "expected a refusal (question is out of scope / unanswerable), but the run answered with kind uncertified"
      ],
      "durationMs": 274472,
      "kind": "uncertified",
      "route": "generated_sql",
      "clarificationOptionCount": 0,
      "conversational": false,
      "conversationalAnswer": false,
      "meaningResolved": false,
      "observability": {
        "recordingStatus": "complete",
        "storeSchemaVersion": 1,
        "traceFingerprint": "sha256:fb607140ab919059c72b8a2e838312af4fe31c3d768047f736c87a4110f49086"
      },
      "reviewStatus": "analyst_review_required",
      "followUp": false,
      "draftSaved": false,
      "toolCalls": 2,
      "providerDispatchCount": 4,
      "expected": {
        "answerable": false
      },
      "answer": {
        "trustState": "review_required",
        "tier": "exploratory",
        "proofs": [
          "executed on the warehouse: 2 rows in 4 ms"
        ],
        "sql": "WITH deductible_by_policy AS (\n    SELECT DISTINCT\n        pa.Policy_Identifier,\n        pa.Policy_Amount AS deductible_amount\n    FROM \"acme_insurance\".\"main\".\"policy_amount\" AS pa\n    WHERE COALESCE(pa.Amount_Type_Code, '') ILIKE '%deductible%'\n),\nclaim_losses AS (\n    SELECT\n        ca.Claim_Identifier,\n        SUM(ca.Claim_Amount) AS incurred_loss_amount\n    FROM \"acme_insurance\".\"main\".\"claim_amount\" AS ca\n    WHERE EXISTS (\n        SELECT 1\n        FROM \"acme_insurance\".\"main\".\"loss_payment\" AS lp\n        WHERE lp.Claim_Amount_Identifier = ca.Claim_Amount_Identifier\n    )\n       OR EXISTS (\n        SELECT 1\n        FROM \"acme_insurance\".\"main\".\"loss_reserve\" AS lr\n        WHERE lr.Claim_Amount_Identifier = ca.Claim_Amount_Identifier\n    )\n    GROUP BY ca.Claim_Identifier\n)\nSELECT\n    p.Policy_Number,\n    p.Policy_Identifier,\n    STRING_AGG(DISTINCT CAST(d.deductible_amount AS VARCHAR), ', ') AS deductible_amounts,\n    COUNT(DISTINCT CASE\n        WHEN cl.incurred_loss_amount < d.deductible_amount THEN c.Claim_Identifier\n    END) AS claims_below_deductible\nFROM \"acme_insurance\".\"main\".\"policy\" AS p\nLEFT JOIN \"acme_insurance\".\"main\".\"policy_coverage_detail\" AS pcd\n  ON pcd.Policy_Identifier = p.Policy_Identifier\nLEFT JOIN deductible_by_policy AS d\n  ON d.Policy_Identifier = p.Policy_Identifier\nLEFT JOIN \"acme_insurance\".\"main\".\"claim_coverage\" AS cc\n  ON cc.Effective_Date = pcd.Effective_Date\n AND cc.Policy_Coverage_Detail_Identifier = pcd.Policy_Coverage_Detail_Identifier\nLEFT JOIN \"acme_insurance\".\"main\".\"claim\" AS c\n  ON c.Claim_Identifier = cc.Claim_Identifier\nLEFT JOIN claim_losses AS cl\n  ON cl.Claim_Identifier = c.Claim_Identifier\nGROUP BY p.Policy_Number, p.Policy_Identifier\nORDER BY p.Policy_Number, p.Policy_Identifier\nLIMIT 500",
        "rowCount": 2,
        "egress": {
          "receipts": 4,
          "resultRows": 0
        }
      },
