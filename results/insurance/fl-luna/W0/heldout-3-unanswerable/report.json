      "answer": {
        "trustState": "review_required",
        "tier": "exploratory",
        "proofs": [
          "executed on the warehouse: 2 rows in 3 ms"
        ],
        "sql": "WITH policy_deductibles AS (\n    SELECT DISTINCT\n        \"Policy_Identifier\",\n        \"Policy_Coverage_Detail_Identifier\",\n        \"Policy_Amount\" AS deductible_amount\n    FROM acme_insurance.main.policy_amount\n    WHERE \"Amount_Type_Code\" ILIKE '%ded%'\n),\nclaim_totals AS (\n    SELECT\n        \"Claim_Identifier\",\n        SUM(\"Claim_Amount\") AS total_claim_amount\n    FROM acme_insurance.main.claim_amount\n    GROUP BY \"Claim_Identifier\"\n),\npolicy_claims AS (\n    SELECT DISTINCT\n        pcd.\"Policy_Identifier\",\n        cc.\"Policy_Coverage_Detail_Identifier\",\n        cc.\"Claim_Identifier\"\n    FROM acme_insurance.main.claim_coverage AS cc\n    JOIN acme_insurance.main.policy_coverage_detail AS pcd\n        ON pcd.\"Policy_Coverage_Detail_Identifier\" = cc.\"Policy_Coverage_Detail_Identifier\"\n)\nSELECT\n    p.\"Policy_Number\",\n    p.\"Policy_Identifier\",\n    LIST(DISTINCT pd.deductible_amount) FILTER (WHERE pd.deductible_amount IS NOT NULL) AS deductible_amounts,\n    COUNT(DISTINCT CASE\n        WHEN ct.total_claim_amount < pd.deductible_amount THEN pc.\"Claim_Identifier\"\n    END) AS claims_below_deductible\nFROM acme_insurance.main.policy AS p\nLEFT JOIN policy_deductibles AS pd\n    ON pd.\"Policy_Identifier\" = p.\"Policy_Identifier\"\nLEFT JOIN policy_claims AS pc\n    ON pc.\"Policy_Identifier\" = p.\"Policy_Identifier\"\n    AND (\n        pd.\"Policy_Coverage_Detail_Identifier\" IS NULL\n        OR pc.\"Policy_Coverage_Detail_Identifier\" = pd.\"Policy_Coverage_Detail_Identifier\"\n    )\nLEFT JOIN claim_totals AS ct\n    ON ct.\"Claim_Identifier\" = pc.\"Claim_Identifier\"\nGROUP BY\n    p.\"Policy_Number\",\n    p.\"Policy_Identifier\"\nORDER BY\n    p.\"Policy_Number\",\n    p.\"Policy_Identifier\"\nLIMIT 500",
        "rowCount": 2,
        "egress": {
          "receipts": 3,
          "resultRows": 0
        }
      },
