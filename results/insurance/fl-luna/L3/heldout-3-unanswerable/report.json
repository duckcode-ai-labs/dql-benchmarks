        "sql": "WITH fire_claim_coverages AS (\n    SELECT DISTINCT\n        cc.Policy_Coverage_Detail_Identifier,\n        cc.Effective_Date\n    FROM \"acme_insurance\".\"main\".\"claim\" AS c\n    JOIN \"acme_insurance\".\"main\".\"catastrophe\" AS cat\n      ON cat.Catastrophe_Identifier = c.Catastrophe_Identifier\n    JOIN \"acme_insurance\".\"main\".\"claim_coverage\" AS cc\n      ON cc.Claim_Identifier = c.Claim_Identifier\n    WHERE lower(cat.Catastrophe_Name) = 'fire'\n),\nrecovery_amounts AS (\n    SELECT DISTINCT\n        pa.Policy_Amount_Identifier,\n        pa.Policy_Amount\n    FROM fire_claim_coverages AS fc\n    JOIN \"acme_insurance\".\"main\".\"policy_amount\" AS pa\n      ON pa.Policy_Coverage_Detail_Identifier = fc.Policy_Coverage_Detail_Identifier\n     AND pa.Effective_Date = fc.Effective_Date\n    WHERE pa.Amount_Type_Code ILIKE '%ced%'\n)\nSELECT COALESCE(SUM(Policy_Amount), 0) AS amount_recovered_from_reinsurers\nFROM recovery_amounts\nLIMIT 501",
