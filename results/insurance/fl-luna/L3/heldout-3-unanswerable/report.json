      "answer": {
        "trustState": "review_required",
        "tier": "exploratory",
        "proofs": [
          "executed on the warehouse: 2 rows in 3 ms"
        ],
        "sql": "WITH deductible_by_coverage AS (\n    SELECT\n        pa.\"Policy_Identifier\",\n        pa.\"Effective_Date\",\n        pa.\"Policy_Coverage_Detail_Identifier\",\n        MAX(pa.\"Policy_Amount\") AS deductible\n    FROM \"acme_insurance\".\"main\".\"policy_amount\" AS pa\n    WHERE pa.\"Amount_Type_Code\" ILIKE '%deductible%'\n    GROUP BY\n        pa.\"Policy_Identifier\",\n        pa.\"Effective_Date\",\n        pa.\"Policy_Coverage_Detail_Identifier\"\n),\npolicy_deductibles AS (\n    SELECT\n        \"Policy_Identifier\",\n        LIST(DISTINCT deductible) AS deductible_amounts\n    FROM deductible_by_coverage\n    GROUP BY \"Policy_Identifier\"\n),\nclaim_amount_by_claim AS (\n    SELECT\n        ca.\"Claim_Identifier\",\n        c.\"Company_Claim_Number\",\n        SUM(ca.\"Claim_Amount\") AS total_claim_amount\n    FROM \"acme_insurance\".\"main\".\"claim_amount\" AS ca\n    JOIN \"acme_insurance\".\"main\".\"claim\" AS c\n      ON ca.\"Claim_Identifier\" = c.\"Claim_Identifier\"\n    GROUP BY ca.\"Claim_Identifier\", c.\"Company_Claim_Number\"\n),\nclaims_below_deductible AS (\n    SELECT\n        pcd.\"Policy_Identifier\",\n        ca.\"Claim_Identifier\",\n        ca.\"Company_Claim_Number\"\n    FROM \"acme_insurance\".\"main\".\"claim_coverage\" AS cc\n    JOIN \"acme_insurance\".\"main\".\"policy_coverage_detail\" AS pcd\n      ON cc.\"Effective_Date\" = pcd.\"Effective_Date\"\n     AND cc.\"Policy_Coverage_Detail_Identifier\" = pcd.\"Policy_Coverage_Detail_Identifier\"\n    JOIN deductible_by_coverage AS d\n      ON pcd.\"Policy_Identifier\" = d.\"Policy_Identifier\"\n     AND pcd.\"Effective_Date\" = d.\"Effective_Date\"\n     AND pcd.\"Policy_Coverage_Detail_Identifier\" = d.\"Policy_Coverage_Detail_Identifier\"\n    JOIN claim_amount_by_claim AS ca\n      ON cc.\"Claim_Identifier\" = ca.\"Claim_Identifier\"\n    WHERE ca.total_claim_amount < d.deductible\n    GROUP BY\n        pcd.\"Policy_Identifier\",\n        ca.\"Claim_Identifier\",\n        ca.\"Company_Claim_Number\"\n)\nSELECT\n    p.\"Policy_Identifier\",\n    p.\"Policy_Number\",\n    pd.deductible_amounts,\n    COUNT(DISTINCT cbd.\"Claim_Identifier\") AS claims_below_deductible\nFROM \"acme_insurance\".\"main\".\"policy\" AS p\nLEFT JOIN policy_deductibles AS pd\n  ON p.\"Policy_Identifier\" = pd.\"Policy_Identifier\"\nLEFT JOIN claims_below_deductible AS cbd\n  ON p.\"Policy_Identifier\" = cbd.\"Policy_Identifier\"\nGROUP BY\n    p.\"Policy_Identifier\",\n    p.\"Policy_Number\",\n    pd.deductible_amounts\nORDER BY p.\"Policy_Number\", p.\"Policy_Identifier\"\nLIMIT 500",
        "rowCount": 2,
        "egress": {
          "receipts": 4,
          "resultRows": 0
        }
