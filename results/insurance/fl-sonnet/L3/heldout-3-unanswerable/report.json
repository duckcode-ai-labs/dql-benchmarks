        "proofs": [
          "executed on the warehouse: 2 rows in 6 ms"
        ],
        "sql": "SELECT\n  p.Policy_Identifier,\n  p.Policy_Number,\n  d.deductible_amount AS deductible,\n  COALESCE(cp.total_claims, 0) AS total_claims\nFROM \"acme_insurance\".\"main\".\"policy\" p\nLEFT JOIN (\n  SELECT Policy_Identifier, Policy_Amount AS deductible_amount\n  FROM \"acme_insurance\".\"main\".\"policy_amount\"\n  WHERE CAST(Amount_Type_Code AS VARCHAR) ILIKE '%deductible%'\n) d ON p.Policy_Identifier = d.Policy_Identifier\nLEFT JOIN (\n  SELECT pcd.Policy_Identifier, COUNT(DISTINCT c.Claim_Identifier) AS total_claims\n  FROM \"acme_insurance\".\"main\".\"claim\" c\n  JOIN \"acme_insurance\".\"main\".\"claim_coverage\" cc\n    ON c.Claim_Identifier = cc.Claim_Identifier\n  JOIN \"acme_insurance\".\"main\".\"policy_coverage_detail\" pcd\n    ON cc.Effective_Date = pcd.Effective_Date\n   AND cc.Policy_Coverage_Detail_Identifier = pcd.Policy_Coverage_Detail_Identifier\n  GROUP BY pcd.Policy_Identifier\n) cp ON p.Policy_Identifier = cp.Policy_Identifier\nORDER BY p.Policy_Identifier\nLIMIT 500",
        "rowCount": 2,
        "egress": {
          "receipts": 4,
          "resultRows": 0
        }
