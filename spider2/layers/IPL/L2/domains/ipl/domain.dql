// dql-format: 1

domain "Ipl" {
  id = "ipl"
  owner = "43963011+KKranthi6881@users.noreply.github.com"
  businessOwner = "IPL cricket analytics"
  boundedContext = "Indian Premier League cricket, seasons 2008-2016: matches with toss, result, venue and man of the match; franchises (teams); players with birth date, batting hand, bowling style and country; the playing XI of each match with each player's team and role; and ball-by-ball records of every delivery with the runs off the bat, extras and dismissals on it."
  reviewCadence = "quarterly"
  sourceSystems = ["warehouse:main.match", "warehouse:main.team", "warehouse:main.player", "warehouse:main.player_match", "warehouse:main.ball_by_ball", "warehouse:main.batsman_scored", "warehouse:main.extra_runs", "warehouse:main.wicket_taken"]
  primaryTerms = ["Match", "Season", "Team", "Player", "Playing XI", "Innings", "Over", "Delivery", "Runs off the bat", "Extras", "Dismissal", "Toss", "Man of the match"]
  tags = ["ipl", "cricket", "sports", "warehouse-first"]
  description = "One domain for the IPL warehouse (SQLite, schema main). Entities bind the eight tables with relation: main.<table>. Modeling areas: matches (match, team, player, player_match) and deliveries (ball_by_ball, batsman_scored, extra_runs, wicket_taken). Known data gaps: team_id 1 has no team row, player_id 35 has no player row, match 419136 has no match row; join those dimensions with LEFT JOIN."
}
