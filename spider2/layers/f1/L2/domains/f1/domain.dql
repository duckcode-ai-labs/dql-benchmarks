// dql-format: 1

domain "F1" {
  id = "f1"
  owner = "43963011+KKranthi6881@users.noreply.github.com"
  businessOwner = "Formula 1 analytics"
  boundedContext = "The Formula 1 World Championship 1950-2024 (data through the 2024 British Grand Prix, 2024-07-07): seasons, races (Grands Prix) and circuits; drivers and constructors (teams); race, sprint and qualifying results with finishing status codes; drivers' and constructors' championship standings after each race; lap times, positions per lap, pit stops and overtakes; driver stints with teams and teammate ranks. Tables ending in _ext and the derived tables (retirements, lap_positions, lap_time_stats, overtakes, drives, team_driver_ranks) are precomputed from the base tables."
  reviewCadence = "quarterly"
  sourceSystems = ["warehouse:main"]
  primaryTerms = ["Season", "Race", "Circuit", "Driver", "Constructor", "Race result", "Sprint result", "Qualifying", "Status", "Driver standing", "Constructor standing", "Lap time", "Pit stop", "Overtake", "Retirement", "Drive"]
  tags = ["formula-1", "motorsport", "warehouse-first"]
  description = "One domain for the whole F1 SQLite warehouse. Entities bind the tables in schema main with relation: main.<table>. Modeled from the data by an AI author; relationships marked certified were checked on the warehouse, not certified by a person."
}
